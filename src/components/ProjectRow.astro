---
import type { Project } from '@types';
interface Props { project: Project }
const { project } = Astro.props as Props;
---
<div class="group relative -mt-px border-y border-white/10 py-5 sm:py-6">
  {project.stack.length > 0 && (
    <span class="chip chip-accent absolute -top-3 left-0 z-10">{project.stack[0]}</span>
  )}
  <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-3">
    <h3 class="text-slate-200">{project.title}</h3>
    <div class="text-xs text-slate-500 mt-1 flex flex-wrap items-center gap-3 sm:mt-0">
      {project.repo && (<a href={project.repo} target="_blank" rel="noopener" class="hover:text-accent">Repo</a>)}
      {project.demo && (<a href={project.demo} target="_blank" rel="noopener" class="hover:text-accent">Demo</a>)}
    </div>
  </div>
  <p class="mt-2 text-sm subtle">{project.summary}</p>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    {project.stack.map((s, i) => (
      <span class={`chip ${i === 0 ? 'chip-accent' : ''}`}>{s}</span>
    ))}
  </div>
</div>
