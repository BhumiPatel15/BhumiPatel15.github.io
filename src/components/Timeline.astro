---
interface Item { title: string; subtitle: string; start: string; end: string; bullets?: string[]; desc?: string }
interface Props { items: Item[]; title?: string; collapsible?: boolean }
const { items, title, collapsible } = Astro.props as Props;
---
<section class="my-12">
  {title && <h2 class="section-title">{title}</h2>}
  <div class="relative pl-5 sm:pl-6">
    <div class="absolute left-1 top-0 bottom-0 w-px bg-gradient-to-b from-accent/60 via-accent/30 to-transparent"></div>
    <ul class="space-y-6">
      {items.map((it) => (
        <li class="relative">
          <div class="absolute left-0 top-3 h-3 w-3 rounded-full bg-accent shadow-glow"></div>
          <details class="code-window" data-collapsible={collapsible ? 'true' : undefined} open>
            <summary class={`flex list-none items-baseline gap-x-3 gap-y-1 p-4 ${collapsible ? 'cursor-pointer' : ''}`}>
              <h3 class="text-slate-200">{it.title}</h3>
              <span class="subtle">{it.subtitle}</span>
              {(it.start || it.end) && (
                <span class="ml-auto text-xs text-slate-500">{it.start}{it.start && it.end ? ' – ' : ''}{it.end}</span>
              )}
            </summary>
            {it.desc ? (
              <p class="-mt-1 mb-4 px-4 text-sm text-slate-300">{it.desc}</p>
            ) : (it.bullets && (
              <ul class="-mt-1 mb-4 px-4 list-disc pl-5 text-sm text-slate-300">
                {it.bullets.map((b) => (<li>{b}</li>))}
              </ul>
            ))}
          </details>
        </li>
      ))}
    </ul>
    <script>
      const prefersWide = () => matchMedia('(min-width: 640px)').matches; // sm breakpoint
      const apply = () => {
        document.querySelectorAll('details[data-collapsible]').forEach((el) => {
          if (!(el instanceof HTMLDetailsElement)) return;
          el.open = prefersWide();
        });
      };
      apply();
      addEventListener('resize', apply);
    </script>
  </div>
</section>
