---
interface Props { options: string[]; selected?: string }
const { options, selected } = Astro.props as Props;
---
<div class="flex flex-wrap gap-2" id="filters">
  {['All', ...options].map(opt => (
    <button class={`rounded-2xl border border-white/15 px-3 py-1 text-xs ${selected===opt ? 'bg-accent/20 text-accent' : 'text-slate-300 hover:text-accent'}`} data-filter={opt}>{opt}</button>
  ))}
</div>
