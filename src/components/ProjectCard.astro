---
import type { Project } from '@types';
import CodeWindow from './CodeWindow.astro';
interface Props { project: Project }
const { project } = Astro.props as Props;
---
<CodeWindow title={project.title}>
  <p class="text-sm subtle">{project.summary}</p>
  <div class="mt-3 flex flex-wrap gap-2">
    {project.stack.map(s => (<span class="rounded border border-white/15 px-2 py-1 text-xs text-slate-300">{s}</span>))}
  </div>
  <div class="mt-4 flex gap-4 text-sm">
    {project.repo && (<a href={project.repo} target="_blank" rel="noopener" class="hover:text-accent">Repo</a>)}
    {project.demo && (<a href={project.demo} target="_blank" rel="noopener" class="hover:text-accent">Demo</a>)}
  </div>
</CodeWindow>
