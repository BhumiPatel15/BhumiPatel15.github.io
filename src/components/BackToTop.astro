<button id="backToTop" class="fixed bottom-6 right-6 hidden rounded-full border border-white/15 bg-black/40 px-3 py-2 text-sm text-slate-200 shadow-glow hover:text-accent" aria-label="Back to top">↑ Top</button>
<script>
  const btn = document.getElementById('backToTop');
  const toggle = () => { if (scrollY > 600) btn?.classList.remove('hidden'); else btn?.classList.add('hidden'); };
  addEventListener('scroll', toggle, { passive: true });
  toggle();
  btn?.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
</script>
